[
  // ===== BASIC INDENT / TAB =====
  { "key": "tab",        "command": "tab",    "when": "editorTextFocus && !editorTabMovesFocus" },
  { "key": "shift+tab",  "command": "outdent","when": "editorTextFocus && !editorTabMovesFocus" },

  // ===== WINDOW NAV (LazyVim: <C-h/j/k/l>) =====
  { "key": "ctrl+h", "command": "workbench.action.focusLeftGroup",  "when": "neovim.mode == 'normal' && editorTextFocus && multipleEditorGroups" },
  { "key": "ctrl+j", "command": "workbench.action.focusBelowGroup", "when": "neovim.mode == 'normal' && editorTextFocus && multipleEditorGroups" },
  { "key": "ctrl+k", "command": "workbench.action.focusAboveGroup", "when": "neovim.mode == 'normal' && editorTextFocus && multipleEditorGroups" },
  { "key": "ctrl+l", "command": "workbench.action.focusRightGroup", "when": "neovim.mode == 'normal' && editorTextFocus && multipleEditorGroups" },

  // single group: cycle editors
  { "key": "ctrl+h", "command": "workbench.action.previousEditor", "when": "neovim.mode == 'normal' && editorTextFocus && !multipleEditorGroups" },
  { "key": "ctrl+l", "command": "workbench.action.nextEditor",     "when": "neovim.mode == 'normal' && editorTextFocus && !multipleEditorGroups" },

  // ===== EXPLORER one-key (when focused) =====
  // ---- ENTER opens files / toggles folders
  { "key": "enter", "command": "explorer.openAndPassFocus", "when": "filesExplorerFocus && !explorerResourceIsFolder && !inputFocus" },
  { "key": "enter", "command": "list.toggleExpand",         "when": "filesExplorerFocus &&  explorerResourceIsFolder && !inputFocus" },

  // --- Toggle Explorer (spam to open/close)
  // from editor → open explorer
  // {
  //   "key": "space e",
  //   "command": "runCommands",
  //   "args": {
  //     "commands": [
  //       "workbench.action.toggleSidebarVisibility",
  //       "workbench.files.action.focusFilesExplorer"
  //     ]
  //   },
  //   "when": "vim.mode == 'Normal' && (editorTextFocus || !inputFocus) && !sideBarFocus"
  // },

  // from sidebar → close explorer and return focus to editor
  {
    "key": "space e",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.toggleSidebarVisibility",
        "workbench.action.focusActiveEditorGroup"
      ]
    },
    "when": "sideBarFocus && !inputFocus"
  },

  // Explorer actions
  { "key": "r",        "command": "renameFile",           "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },
  { "key": "a",        "command": "explorer.newFile",     "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },
  { "key": "shift+a",  "command": "explorer.newFolder",   "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },
  { "key": "d",        "command": "deleteFile",           "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },
  { "key": "c",        "command": "filesExplorer.copy",   "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },
  { "key": "ctrl+x c",        "command": "filesExplorer.cut",    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },
  { "key": "p",        "command": "filesExplorer.paste",  "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },
  { "key": "s",        "command": "explorer.openToSide",  "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus" },

  // (dup safeguard) ENTER rules with foldersViewVisible
  { "key": "enter", "command": "explorer.openAndPassFocus", "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceIsFolder && !inputFocus" },
  { "key": "enter", "command": "list.toggleExpand",         "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot &&  explorerResourceIsFolder && !inputFocus" },

  // ===== COMMENT SHORTCUT =====
  { "key": "ctrl+/", "command": "editor.action.commentLine", "when": "editorTextFocus" },
  
  // ===== JUPYTER SHORTCUT =====
  // Insert NOTEBOOK cell ABOVE
  {
    "key": "space a",
    "command": "notebook.cell.insertCodeCellAboveAndFocusContainer",
    "when": "notebookEditorFocused && neovim.mode == 'normal'"
  },

  // Insert NOTEBOOK cell BELOW
  {
    "key": "space b",
    "command": "notebook.cell.insertCodeCellBelowAndFocusContainer",
    "when": "notebookEditorFocused && neovim.mode == 'normal'"
  },

  // Change to MARKDOWN cell
  {
    "key": "space m",
    "command": "notebook.cell.changeToMarkdown",
    "when": "notebookEditorFocused && neovim.mode == 'normal'"
  },

  // Change to CODE cell
  {
    "key": "space c",
    "command": "notebook.cell.changeToCode",
    "when": "notebookEditorFocused && neovim.mode == 'normal'"
  },

  // Quick Open: <Space><Space> in notebooks
  {
    "key": "space space",
    "command": "workbench.action.showAllEditors",
    "when": "notebookEditorFocused && neovim.mode == 'normal'"
  },

  // Explorer: <Space>e
  {
    "key": "space e",
    "command": "workbench.view.explorer",
    "when": "notebookEditorFocused && neovim.mode == 'normal'"
  },

  // Find in files: choose a 2-key chord (VSCode can't do 3-step <Space> f f)
  {
    "key": "space f",
    "command": "workbench.action.findInFiles",
    "when": "notebookEditorFocused && neovim.mode == 'normal'"
  },

  // Close editor: <Space>q
  {
    "key": "space q",
    "command": "workbench.action.closeActiveEditor",
    "when": "notebookEditorFocused && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+x",
    "command": "-filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  }
]
