{
  // --- Core / UI ---
  "editor.fontFamily": "'RobotoMono Nerd Font Mono'",
  "workbench.iconTheme": "material-icon-theme",
  "security.workspace.trust.untrustedFiles": "open",
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.tree.indent": 8,
  "workbench.tree.renderIndentGuides": "none",
  "explorer.decorations.badges": false,
  "explorer.decorations.colors": false,
  "explorer.confirmDragAndDrop": false,
  "workbench.colorTheme": "Tokyo Night Storm",
  "workbench.activityBar.location": "hidden",

  // --- Editor behavior ---
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": false,
  "editor.cursorBlinking": "solid",
  "editor.renderWhitespace": "none",
  "editor.renderControlCharacters": false,
  "editor.stickyScroll.enabled": false,
  "editor.hover.enabled": true,
  "editor.lightbulb.enabled": "on",
  "editor.quickSuggestions": { "comments": "on", "strings": "on", "other": "on" },
  "editor.parameterHints.enabled": true,
  "editor.suggestOnTriggerCharacters": true,
  "editor.inlineSuggest.enabled": true,
  "editor.codeLens": true,
  "editor.occurrencesHighlight": "off",
  "editor.selectionHighlight": true,
  "editor.guides.bracketPairs": true,
  "editor.linkedEditing": true,

  // --- Neovim bridge (Use WSL Ubuntu Neovim) ---
  "extensions.experimental.affinity": { "asvetliakov.vscode-neovim": 1 },

  // Tell VSCode-Neovim to run inside WSL
  "vscode-neovim.useWSL": true,
  "vscode-neovim.neovimExecutablePaths.linux": "/usr/local/bin/nvim",

  // Use the same VSCode-specific config directory as Ubuntu
  // (~/.config/nvim-vscode)
  "vscode-neovim.NVIM_APPNAME": "nvim-vscode",

  // Key handling
  "vscode-neovim.useCtrlKeys": true,
  "vscode-neovim.handleKeys": {
    "<C-z>": false,
    "<C-S-z>": false,
    "<C-y>": false,
    "<C-v>": true
  },

  // Required for accurate <C-...> mapping on Windows
  "keyboard.dispatch": "keyCode",

  // --- Git ---
  "git.enabled": true,
  "git.autorefresh": false,
  "git.decorations.enabled": false,

  // --- File watching / search ---
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/out/**": true,
    "**/target/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true,
    "**/out": true,
    "**/target": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "search.followSymlinks": false,

  // --- Updates / telemetry ---
  "telemetry.telemetryLevel": "off",
  "update.mode": "none",
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,

  // --- Terminal ---
  "terminal.integrated.enableImages": true,
  "accessibility.signals.terminalBell": { "sound": "off" },
  "terminal.integrated.enableVisualBell": false,
  "terminal.integrated.sendKeybindingsToShell": true,

  // --- Editing niceties ---
  "makefile.configureOnOpen": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.inlayHints.enabled": "offUnlessPressed",

  // --- C++ / clangd --- (disabled because paths differ on Windows)
  // "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.codeAnalysis.enabled": false,
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.formatting": "disabled",
  "C_Cpp.autocomplete": "disabled",

  // If you want clangd from WSL, uncomment this:
  // "clangd.path": "/usr/bin/clangd",
  // "clangd.arguments": [
  //   "--background-index",
  //   "--clang-tidy",
  //   "--header-insertion=never"
  // ],

  // --- CMake integration ---
  "cmake.configureOnOpen": false,

  // --- VSCode UX Cleanup ---
  "workbench.layoutControl.enabled": false,
  "chat.commandCenter.enabled": false,
  "window.menuBarVisibility": "compact",
  "workbench.editor.editorActionsLocation": "titleBar",
  "window.commandCenter": false
}